# Copy to .env locally and set your own bot token.
# Never commit .env or share this value.
TELEGRAM_BOT_TOKEN=replace_with_token_from_botfather

# Optional: Telegram chat ID that receives new sales inquiry notifications
ADMIN_CHAT_ID=
# Optional: SQLite file path for inquiries
LEADS_DB_PATH=aura_leads.sqlite3

# Lead retention window in days (1–3650); default is 90.
LEADS_RETENTION_DAYS=90

# Maximum sales inquiries per Telegram user in a rolling 24-hour window (1–20); default is 3.
LEADS_MAX_PER_USER_24H=3
