# Required: create a bot with @BotFather and keep this token private.
TELEGRAM_BOT_TOKEN=replace_with_token_from_botfather

# Comma-separated numeric Telegram user IDs allowed to manage the store.
ADMIN_IDS=

# Use a persistent writable path on the deployment host.
AURA_DATABASE_PATH=aura_store.db

# Display currency only; use a 3-letter code such as USD. No payment processing.
AURA_CURRENCY=USD
